generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Room {
  id           String    @id @default(uuid())
  code         String    @unique
  hostSocketId String
  sceneId      String?
  status       String    @default("waiting") // waiting | playing | recording | rendering | completed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  scene     Scene?     @relation(fields: [sceneId], references: [id])
  players   Player[]
  recordings Recording[]
  renders   Render[]
}

model Player {
  id          String   @id @default(uuid())
  roomId      String
  socketId    String
  nickname    String
  discordId   String?
  avatarUrl   String?
  isHost      Boolean  @default(false)
  isReady     Boolean  @default(false)
  characterId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  character  Character? @relation(fields: [characterId], references: [id])
  recordings Recording[]
}

model Scene {
  id          String   @id @default(uuid())
  name        String
  description String
  videoPath   String
  audioMode   String   @default("original") // original | background | muted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters Character[]
  rooms      Room[]
  renders    Render[]
}

model Character {
  id         String   @id @default(uuid())
  sceneId    String
  name       String
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scene     Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  dialogues Dialogue[]
  players   Player[]
}

model Dialogue {
  id          String   @id @default(uuid())
  characterId String
  text        String
  startTime   Float    // saniye cinsinden
  endTime     Float    // saniye cinsinden
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character  Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  recordings Recording[]
}

model Recording {
  id         String   @id @default(uuid())
  dialogueId String
  playerId   String
  roomId     String
  filePath   String
  duration   Float    // saniye cinsinden
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dialogue Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Render {
  id           String   @id @default(uuid())
  roomId       String
  sceneId      String
  status       String   @default("pending") // pending | processing | completed | failed
  progress     Int      @default(0)
  outputPath   String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scene Scene @relation(fields: [sceneId], references: [id])
}
